# /var/www/AI-Agent/python-agent/.env on the EC2 server (never committed).
# MONGO_URI, QDRANT_URL, REDIS_URL and BACKEND_URL are set by docker-compose.yml — values here are ignored.

# Must be identical to backend/.env
JWT_SECRET=
# Must be identical to backend/.env (both services read stored integration tokens)
ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional fast path for simple questions; leave empty to use Anthropic only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

QDRANT_API_KEY=
QDRANT_COLLECTION=documents
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CRM_BASE_URL=
CRM_API_KEY=
# The one business the CRM above belongs to (its organization id). AI search does not
# index that CRM without it, so one business can never find another's records.
CRM_RAG_ORGANIZATION_ID=
CRM_MONGO_SYNC_INTERVAL_MINUTES=2

MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

SEARCH_API_KEY=
