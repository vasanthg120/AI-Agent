# /var/www/AI-Agent/.env on the EC2 server (never committed) — read by docker compose,
# deploy.sh and the backup script.

# Baked into the frontend when deploy.sh builds it: where the browser reaches the backend through Nginx.
VITE_API_URL=https://app.example.com/api
VITE_SOCKET_URL=https://app.example.com

# S3 bucket for the nightly MongoDB backup (deploy/backup/mongo-backup.sh). Empty: backups stay on the server.
BACKUP_BUCKET=
