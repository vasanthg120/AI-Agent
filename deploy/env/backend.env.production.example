# /var/www/AI-Agent/backend/.env on the EC2 server (never committed).
# Replace app.example.com with your domain everywhere. Leave a line empty to switch that integration off.
# MONGO_URI, PYTHON_AGENT_URL and REDIS_URL are set by docker-compose.yml — values here are ignored.

PORT=3000
NODE_ENV=production

# Must be identical in python-agent/.env. Generate: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Encrypts stored integration tokens (Outlook, Google Drive, OneDrive…). Generate once, never change:
# openssl rand -hex 32 — changing it makes every stored connection unreadable.
ENCRYPTION_KEY=

# The browser address of the app. Also the address put in emails.
CORS_ORIGIN=https://app.example.com
APP_URL=https://app.example.com

# Where outside services reach the backend through Nginx (webhooks: Plivo, Twilio, Zapier/Hoops CRM pushes).
PUBLIC_API_BASE_URL=https://app.example.com/api
PLIVO_PUBLIC_BASE_URL=https://app.example.com/api

# Pantheras CRM (organization-wide fallback; organizations usually connect their own on the Integrations page)
CRM_BASE_URL=
CRM_API_KEY=

# Microsoft (Outlook mailboxes and OneDrive). Register these EXACT return addresses on the Azure app:
#   https://app.example.com/api/outlook/callback
#   https://app.example.com/api/outlook/admin-consent-callback
#   https://app.example.com/api/auth/oauth/microsoft/callback
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REDIRECT_URI=https://app.example.com/api/outlook/callback
MS_GRAPH_ADMIN_CONSENT_REDIRECT_URI=https://app.example.com/api/outlook/admin-consent-callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=https://app.example.com/api/auth/oauth/microsoft/callback
MICROSOFT_OAUTH_TENANT=common

# Google (Gmail mailboxes, Google Drive, "Sign in with Google") — register the matching return addresses.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.example.com/api/gmail/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://app.example.com/api/cloud-files/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/api/auth/oauth/google/callback

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Outgoing email (password resets, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Payments: test keys until you switch PAYMENT_MODE to live.
PAYMENT_MODE=test
ACTIVE_PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID_TEST=
RAZORPAY_KEY_SECRET_TEST=
RAZORPAY_WEBHOOK_SECRET_TEST=
# Live mode reads RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET.
# Without the webhook secret, live payment notices are refused. Set the _TEST secret on
# any server the internet can reach: test mode accepts unsigned notices.

BILLING_ORG_SCOPED_WALLETS=true
